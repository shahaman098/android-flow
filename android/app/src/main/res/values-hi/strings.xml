<resources>
    <string name="app_name">Android Flow</string>
    <string name="accessibility_service_description">Android Flow ऐक्सेसिबिलिटी का उपयोग करके फोकस किए गए टेक्स्ट फ़ील्ड को पढ़ता है और डिक्टेशन, वाइब प्रॉम्प्ट तथा व्याकरण सुधार डालता है। यह फोकस किए गए संपादन योग्य फ़ील्ड के अलावा आपकी स्क्रीन नहीं देखता।</string>
