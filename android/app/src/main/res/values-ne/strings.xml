    <string name="app_name">Android Flow</string>
    <string name="accessibility_service_description">Android Flow ले Accessibility प्रयोग गरेर फोकस गरिएको टेक्स्ट फिल्ड पढ्छ र डिक्टेसन, भाइब प्रॉम्प्ट तथा व्याकरण सुधार हाल्छ। यसले फोकस गरिएको सम्पादनयोग्य फिल्डबाहेक तपाईंको स्क्रिन हेर्दैन।</string>
