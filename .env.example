# Local app config - copy to ~/Library/Application Support/voice-flow/.env
# Do not commit real keys.

# Local mode: Mac records/pastes locally, transcribes with whisper.cpp, then calls the LLM API.
PROCESSING_MODE=local
STT_PROVIDER=local_whisper
LOCAL_WHISPER_MODEL_PATH=/Users/YOU/Library/Application Support/voice-flow/models/ggml-small.en.bin
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-...
LLM_MODEL=deepseek-v4-flash

# Optional low-CPU STT API instead of local Whisper:
# STT_PROVIDER=groq_whisper
# GROQ_API_KEY=gsk_...
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional xAI LLM instead of DeepSeek:
# LLM_PROVIDER=xai
# LLM_BASE_URL=https://api.x.ai/v1
# XAI_API_KEY=xai-...
# LLM_MODEL=grok-4.3

# Hybrid: Mac STT + Cloud Run LLM. Requires FLOW_API_* plus a local STT provider.
# PROCESSING_MODE=hybrid
# FLOW_API_URL=https://flow-api-xxxxx.run.app
# FLOW_API_KEY=...

# Cloud: Mac records/pastes only; Cloud Run does STT + LLM.
# cloud/deploy.sh writes these automatically after deploy.
# PROCESSING_MODE=cloud
# FLOW_API_URL=https://flow-api-xxxxx.run.app
# FLOW_API_KEY=...

# Optional GCP Speech fallback:
# STT_PROVIDER=gcp_speech
# gcloud auth application-default login
