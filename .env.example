# Local / cloud env for Android Flow

# Do not commit real keys.

# --- Cloud Run deploy (cloud/deploy.sh) ---
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=sk-...
# Optional:
# LLM_PROVIDER=xai
# XAI_API_KEY=xai-...
# STT_PROVIDER=gcp_speech

# --- Values to paste into the Android Hub ---
# FLOW_API_URL=https://flow-api-xxxxx.run.app
# FLOW_API_KEY=...

# --- Local API for phone testing (same Wi‑Fi) ---
# FLOW_API_URL=http://192.168.x.x:8080
# FLOW_API_KEY=dev-local-key
